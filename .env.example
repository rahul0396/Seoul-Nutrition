# Copy this file to .env (local) and add the same keys in Vercel > Project > Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers). Free M0 cluster is fine to start.
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/seoul?retryWrites=true&w=majority

# Any long random string. Generate one with:  openssl rand -hex 32
# Keep it secret and never change it after launch (it signs admin logins).
PAYLOAD_SECRET=

# Your site's public address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when you add the webhook (Dashboard > Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Product photo storage on Vercel (Vercel > Storage > Blob > Create). Not needed locally.
BLOB_READ_WRITE_TOKEN=
